"""Modal entrypoint for a Devin Outposts pool."""

import modal
from pydantic import Field
from pydantic_settings import BaseSettings, SettingsConfigDict

from modal_devin import outpost

POOL_NAME = $pool_name
POOL_ID = $pool_id
API_URL = $api_url


class Settings(BaseSettings):
    model_config = SettingsConfigDict(env_prefix="WORKER_", extra="ignore")

    poll_interval_secs: int = Field(default=outpost.POLL_INTERVAL_SECS, gt=0)
    session_timeout_secs: int = Field(default=outpost.SESSION_TIMEOUT_SECS, gt=0)


settings = Settings()


# install_ffmpeg/install_chrome default to on (screen recording / browser tools "just work");
# pass False for either to skip it and get a leaner, faster-to-build image.
image = outpost.worker_image().pip_install("pydantic-settings>=2.0")
# Devin requires every session repo checked out as a direct subdirectory of the workdir
# `devin worker start` runs from (outpost.run_session runs it from /root/workspace) -- clone
# each repo straight into /root/workspace/<repo>, not into a nested path:
# image = (
#     image.run_commands("git clone https://github.com/your-org/app /root/workspace/app")
#     .run_commands("git clone https://github.com/your-org/infra /root/workspace/infra")
# )
#
# For a private repo, use outpost.clone_private_repo instead of a bare `git clone` -- it scrubs
# the token back out of .git/config before the image layer commits (see its docstring for why a
# plain `git clone https://TOKEN@...` would bake a live credential into every session's sandbox):
# image = outpost.clone_private_repo(
#     image, "https://github.com/your-org/app", "/root/workspace/app",
#     token_secret=modal.Secret.from_name("github-clone-token"),
# )

app = modal.App(f"outpost-pool-{POOL_NAME}")
secret = modal.Secret.from_name($secret_name)


@app.function(image=image, secrets=[secret], timeout=settings.session_timeout_secs + 60)
def run_session(session_id: str, *, sidecar_image_id: str) -> None:
    outpost.run_session(
        app, image, session_id,
        pool_name=POOL_NAME, pool_id=POOL_ID, api_url=API_URL,
        sidecar_image_id=sidecar_image_id,
        session_timeout_secs=settings.session_timeout_secs,
    )


@app.function(
    image=image,
    secrets=[secret],
    schedule=modal.Period(seconds=settings.poll_interval_secs),
)
def poll_and_dispatch() -> None:
    outpost.poll_and_dispatch(
        pool_name=POOL_NAME, pool_id=POOL_ID, api_url=API_URL,
        run_session_fn=run_session,
    )
